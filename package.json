{
  "name": "pulsebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run typecheck && vite build",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "ci": "npm run lint && npm run lint:md && npm run typecheck && npm run test && npm run test:e2e && npm run dead-code",
    "lint:md": "markdownlint-cli2",
    "dead-code": "fallow dead-code"
  },
  "dependencies": {
    "@audio/decode-aiff": "1.2.3",
    "@audio/decode-flac": "1.2.3",
    "@audio/decode-wav": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fallow": "^3.10.0",
    "globals": "17.8.0",
    "jsdom": "30.0.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
